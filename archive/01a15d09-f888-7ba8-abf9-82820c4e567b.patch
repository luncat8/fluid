diff --git a/experiments/vortex-decay.js b/experiments/vortex-decay.js
new file mode 100644
index 0000000..8b01043
--- /dev/null
+++ b/experiments/vortex-decay.js
@@ -0,0 +1,114 @@
+"use strict";
+// 0.6.0 t5 baseline. A Gaussian vortex on a uniform still box, gravity off,
+// viscosity 0. Retained kinetic energy is the decay metric: mac-cormack is
+// worth adopting only if it keeps >= 25 % more of that energy than
+// semi-Lagrangian at the same time, with the limiter watchdog at 0.
+// Not adopted from this script. The GPU path does not read cfg.macCormack.
+// run: node experiments/vortex-decay.js
+
+const path = require("node:path");
+const root = path.resolve(__dirname, "..");
+require(path.join(root, "src/core/config.js"));
+require(path.join(root, "src/core/grid.js"));
+require(path.join(root, "src/core/stats.js"));
+require(path.join(root, "src/core/multigrid.js"));
+const solverMod = require(path.join(root, "src/core/solver.js"));
+const grid = Fluid.core.grid;
+const cfg0 = Fluid.core.config.defaults;
+const DT = 1 / 240;
+
+function make(N, mac) {
+	const cfg = Object.assign({}, cfg0, {
+		N, scenario: "still", substepsAuto: false, substepsFixed: 1,
+		useMultigrid: true, mgCycles: 2, mgPre: 4, mgPost: 8, mgCoarseIters: 20,
+		gravityY: 0, viscosity: 0, beta: 0, thermalSources: 0, macCormack: mac ? 1 : 0
+	});
+	cfg.texW = N + 2;
+	cfg.texH = N + 2;
+	Fluid.core.config.prepareScenario(cfg);
+	return { cfg, sim: solverMod.create(cfg) };
+}
+function seed(sim, N) {
+	const buf = grid.curBuf(sim.vel);
+	const texW = sim.texW;
+	const cx = N * 0.5, cy = N * 0.5, sigma = N * 0.12, omega = 8;
+	const s2 = sigma * sigma;
+	for (let y = 1; y < sim.texH - 1; y++) {
+		for (let x = 1; x < sim.texW - 1; x++) {
+			const vi = (x + y * texW) * 2;
+			if (!sim.uBlocked(x, y)) {
+				const fx = (x - 1) - cx, fy = (y - 0.5) - cy, r2 = fx * fx + fy * fy;
+				buf[vi] = azimuth(omega, s2, r2, fy);
+			} else buf[vi] = 0;
+			if (!sim.vBlocked(x, y)) {
+				const fx = (x - 0.5) - cx, fy = (y - 1) - cy, r2 = fx * fx + fy * fy;
+				buf[vi + 1] = -azimuth(omega, s2, r2, fx);
+			} else buf[vi + 1] = 0;
+		}
+	}
+}
+function azimuth(omega, s2, r2, tangent) {
+	if (r2 < 1e-8) return 0;
+	const r = Math.sqrt(r2);
+	const uth = omega * s2 / r * (1 - Math.exp(-r2 / (2 * s2)));
+	return -uth * tangent / r;
+}
+function kinetic(sim) {
+	const buf = grid.curBuf(sim.vel);
+	const texW = sim.texW;
+	let e = 0;
+	for (let y = 1; y < sim.texH - 1; y++) {
+		for (let x = 1; x < sim.texW - 1; x++) {
+			const vi = (x + y * texW) * 2;
+			if (!sim.uBlocked(x, y)) e += buf[vi] * buf[vi];
+			if (!sim.vBlocked(x, y)) e += buf[vi + 1] * buf[vi + 1];
+		}
+	}
+	return e;
+}
+function projectOnce(sim, cfg) {
+	sim.poissonRhs(DT);
+	sim.project(Fluid.core.config.solverIters(cfg));
+	sim.applyGrad(DT);
+}
+function run(N, steps, mac, withProject) {
+	const { cfg, sim } = make(N, mac);
+	seed(sim, N);
+	projectOnce(sim, cfg);
+	const ke0 = kinetic(sim);
+	let limited = 0, over = 0;
+	const t0 = Date.now();
+	for (let s = 0; s < steps; s++) {
+		sim.advectVel(DT);
+		limited += sim.diag.velLimited;
+		over += sim.diag.velOvershoot;
+		if (withProject) projectOnce(sim, cfg);
+	}
+	return {
+		kept: kinetic(sim) / ke0,
+		limited, over,
+		ms: (Date.now() - t0) / steps
+	};
+}
+function line(label, r) {
+	console.log("  " + label.padEnd(18) +
+		" kept=" + r.kept.toExponential(3) +
+		" limited=" + r.limited +
+		" overshoot=" + r.over +
+		" cpu=" + r.ms.toFixed(2) + "ms");
+}
+const N = Number(process.argv[2]) || 64;
+const steps = Number(process.argv[3]) || 240;
+console.log("vortex-decay · N=" + N + " steps=" + steps + " dt=" + DT +
+	" · kept = KE/KE0 after a projected seed");
+for (const project of [false, true]) {
+	console.log(project ? "== advect + project ==" : "== advect only ==");
+	const sl = run(N, steps, false, project);
+	const mc = run(N, steps, true, project);
+	line("semi-lagrangian", sl);
+	line("mac-cormack", mc);
+	const gain = sl.kept > 0 ? mc.kept / sl.kept : 0;
+	console.log("  retained ratio mc/sl=" + gain.toFixed(3) +
+		(mc.over === 0 ? "  watchdog=0" : "  WATCHDOG " + mc.over));
+}
+console.log("done");
